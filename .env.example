# Vaultara environment configuration (development)
#
# Copy this file to `.env.local` and adjust as needed.
# Only variables prefixed with VITE_ are exposed to browser code.
# NEVER put provider credentials or secrets in a VITE_ variable: they are
# embedded in the client bundle and are public.
#
# The backend API base URL. Leave empty/unset for a frontend-only session;
# backend-backed accounts and cross-device sync arrive in roadmap Phase 6.
# Must be an absolute http(s) URL when set.
VITE_API_BASE_URL=

# The Adult provider is opt-in and disabled by default (design spec section 13).
# Set to "true" only where the applicable access requirements are satisfied.
VITE_ENABLE_ADULT_PROVIDER=false
