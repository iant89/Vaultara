{
  "compilerOptions": {
    "target": "ES2022",
    /* `page.evaluate` callbacks run inside the browser, so the DOM types are required here.
       Kept in a dedicated config so Node-side tooling stays free of DOM globals. */
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["e2e"]
}
